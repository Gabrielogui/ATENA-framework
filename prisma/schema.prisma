// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model GrupoPesquisa {
  id            String        @id @default(uuid())
  apiGrupoId    String?       @unique
  dgpId         String?
  nome          String
  anoFormacao   Int?
  situacao      String?
  repercussao   String?
  missao        String?
  sobre         String?
  contato       String[]
  pesquisadores Pesquisador[]
  users         User[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Pesquisador {
  id                String        @id @default(uuid())
  nome              String
  tipo              String
  formacaoAcademica String?
  lattesId          String
  grupoPesquisaId   String
  grupoPesquisa     GrupoPesquisa @relation(fields: [grupoPesquisaId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  grupoId   String?
  grupo     GrupoPesquisa? @relation(fields: [grupoId], references: [id])
  criadoEm  DateTime @default(now())
}